config RP23XX_I2S_MAXINFLIGHT
	int "I2S queue size"
	default 16
	---help---
		This is the total number of transfers that can be enqueue before
		the caller is required to wait.  This setting determines the number
		certain queue data structures that will be pre-allocated.

config RP23XX_I2S_DATALEN
	int "Data width (bits)"
	default 16
	---help---
		Data width in bits.  This is a default value and may be change
		via the I2S interface

config RP23XX_I2S_PIO
	int "RP23XX PIO number used for I2S (0-1)"
	default 0
	range 0 1

config RP23XX_I2S_PIO_SM
	int "RP23XX PIO state machine number used for I2S (0-3)"
	default 0
	range 0 3

endif # RP23XX_I2S

#####################################################################
#  SDIO Configuration
#####################################################################

config RP23XX_SDIO
	bool "SD card on a PIO SDIO host (4-bit SD bus)"
	default n
	depends on MMCSD
	select ARCH_HAVE_SDIO
	select ARCH_HAVE_SDIO_PREFLIGHT
	select ARCH_HAVE_SDIOWAIT_WRCOMPLETE
	select MMCSD_SDIO
	select SDIO_DMA
	select SDIO_BLOCKSETUP
	select RP23XX_DMAC
	---help---
		An SD host for the 4-bit SD bus built from one PIO block (three
		of its state machines, all 32 instructions) and three DMA
		channels (rp23xx_sdio.c), for drivers/mmcsd/mmcsd_sdio.c:
		25 MHz default speed, 50 MHz high speed at a 300 MHz system
		clock, the sampling points tuned to the card and the board.
		The board calls rp23xx_sdio_initialize() and
		mmcsd_slotinitialize().  Set CONFIG_MMCSD_MULTIBLOCK_LIMIT to
		at most RP23XX_SDIO_MAXBLOCKS.

if RP23XX_SDIO

config RP23XX_SDIO_PIO
	int "PIO block"
	default 2
	range 0 2

config RP23XX_SDIO_CLK_GPIO
	int "CLK pin"
	default 30

config RP23XX_SDIO_CMD_GPIO
	int "CMD pin"
	default 31

config RP23XX_SDIO_D0_GPIO
	int "DAT0 pin (DAT1-DAT3 follow it)"
	default 40

config RP23XX_SDIO_MAXBLOCKS
	int "Most blocks in one transfer"
	default 32
	range 1 1024
	---help---
		Sizes the DMA control block and CRC tables and the SRAM buffer
		that transfers to and from the PSRAM go through: 548 bytes of
		SRAM a block (17.5 KB at 32).

config RP23XX_SDIO_HIGHSPEED
	bool "High speed (50 MHz)"
	default y
	---help---
		Offer high speed to the MMC/SD driver, which switches a card
		that can (CMD6) and then sets the 50 MHz clock (the system
		clock divided by 6, rounded down to a whole divider).  The host
		falls back to 25 MHz if no sampling point works there.

config RP23XX_SDIO_PROBETRACE
	bool "Trace the probe's CMD8 (debug)"
	default n
	---help---
		Sample CLK and CMD with the PIO block's fourth state machine
		around the probe's first CMD8 and log CMD at each rising edge.

endif # RP23XX_SDIO

