#####################################################################
#  Timer Configuration
#####################################################################

menuconfig RP23XX_TIMER
	bool "System timer (/dev/timer) support"
	default n
	select TIMER
	---help---
		Build the /dev/timerN driver on top of the RP2350 system timer
		blocks (TIMER0 and TIMER1).  Each block is a free-running 64-bit
		microsecond counter, independent of the ARM SysTick that drives
		the OS tick, so it is available for application timers.  The
		driver uses ALARM0 of a block for a single-shot or periodic
		timeout with 1 us resolution.

		Enable one or both blocks below.  A block claimed by the tickless
		oneshot (CONFIG_RP23XX_SYSTIMER_TICKLESS) is removed from the list
		so the two features never collide on the same block.

if RP23XX_TIMER

config RP23XX_TIMER0
	bool "Register TIMER0 as /dev/timer0"
	default y
	depends on !RP23XX_SYSTIMER_TICKLESS_TIMER0
	---help---
		Bind the TIMER0 block to /dev/timer0.  Unavailable when the
		tickless oneshot is configured to use TIMER0.

config RP23XX_TIMER1
	bool "Register TIMER1 as /dev/timer1"
	default n
	depends on !RP23XX_SYSTIMER_TICKLESS_TIMER1
	---help---
		Bind the TIMER1 block to /dev/timer1.  Unavailable when the
		tickless oneshot is configured to use TIMER1.

endif # RP23XX_TIMER

#####################################################################
#  ADC Configuration
#####################################################################

config RP23XX_DCP
	bool "Double-precision arithmetic on the DCP coprocessor"
	default n
	---help---
		The double-precision run-time helpers (__aeabi_dadd, dsub, dmul,
		ddiv, the comparisons and conversions) and newlib's __ieee754_sqrt
		(sqrt, and through it acos, asin, hypot, pow...) on the RP2350's
		double-precision coprocessor instead of libgcc's soft-float: the
		same results bit for bit, several times faster
		(rp23xx_dcp.S, docs/hardware-accel.md).  Loadable modules link a
		copy of them before libgcc (MODULE_RTLIBS).

config RP23XX_DCP_SRAM
	bool "DCP helpers in SRAM"
	default y
	depends on RP23XX_DCP
	---help---
		The helpers (about 1.3 KB) run from SRAM instead of the flash,
		away from the XIP cache that the flash and the PSRAM share.

config RP23XX_SHA256
	bool "SHA-256 accelerator"
	default n
	depends on CRYPTO
	---help---
		rp23xx_sha256_init/update/final (rp23xx_sha256.h): SHA-256 on the
		RP2350's accelerator, for any number of computations at once from
		both cores (the ones it cannot serve are computed in software).
		With CRYPTO_CRYPTODEV_HARDWARE, /dev/crypto's SHA-256 uses it.

config RP23XX_RNG
	bool "Enable hardware TRNG (/dev/random)"
	default n
	select ARCH_HAVE_RNG
	---help---
		Enable the RP2350 hardware true random number generator.  Provides
		/dev/random (and /dev/urandom when CONFIG_DEV_URANDOM selects the
		architecture source) via the TRNG entropy register (EHR).

config RP23XX_RNG_SAMPLE_CNT
	int "TRNG: clock cycles between ring oscillator samples"
	default 512
	depends on RP23XX_RNG
	---help---
		SAMPLE_CNT1: how many cycles (of clk_sys) the TRNG waits between
		two samples of its ring oscillator, which sets how fast it
		delivers bits: fewer cycles, faster, less jitter gathered per
		bit.  Measured at 300 MHz: 65535 (the hardware's reset value)
		gives about 140 bytes a second, 4096 2.3 KB/s, 256 43 KB/s; at
		64 the on-chip autocorrelation test fails.  The default keeps a
		margin of 8 from that.  0 leaves the reset value.

config RP23XX_WDT_ALLCPUS
	bool "Watchdog: kicked only when every CPU answers"
	default y
	depends on WATCHDOG && SMP
	---help---
		Before each reload of the watchdog (the auto-monitor's kick, or a
		WDIOC_KEEPALIVE), make an SMP call to every CPU and wait for all
		of them to run it.  A CPU spinning with its interrupts disabled
		never answers, so the kick never comes and the chip resets, even
		while the other CPU carries on scheduling.  Kicks from interrupt
		context (the WDOG or capture auto-monitors) skip the check.

config RP23XX_RTC
	bool "Enable RTC (POWMAN always-on timer)"
	default n
	select RTC
	---help---
		Use the RP2350 POWMAN always-on timer as the real-time clock backing
		the system clock.  The RP2350 has no dedicated RTC block; the POWMAN
		timer is a 64-bit millisecond counter clocked from the low-power
		oscillator, so it keeps running across warm resets.

config RP23XX_ADC
	bool "Enable ADC Support"
	default n
	---help---
		If y, the RP23XX ADC code will be built.
		If the ADC device driver is not built, basic functions
		to programmatically access the ADC ports will be added.

if RP23XX_ADC

if ADC

config RP23XX_ADC_SWTRIG
	bool "Convert only when triggered (ANIOC_TRIGGER)"
	default n
	---help---
		Without this, an open ADC device converts its channels round and
		round, an interrupt for each conversion (about 500,000 a second),
		for as long as it is open.  With it, each ANIOC_TRIGGER ioctl
		converts each channel of the open devices once, and the ADC then
		stops until the next trigger.

config RP23XX_ADC_CHANNEL0
	bool "Read ADC channel 0"
	default n
	---help---
		If y, then ADC0 will be read.

config RP23XX_ADC_CHANNEL1
	bool "Read ADC channel 1"
	default n
	---help---
		If y, then ADC1 will be read.

